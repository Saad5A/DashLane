# Copy to .env and fill in real values. Never commit .env. Restart the app after changes.

# Google OAuth (redirect URI: http://localhost:5039/signin-google)
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=

# SMS one-time codes — Twilio Verify (works on a trial account: texts go only to numbers
# verified at console.twilio.com → Phone Numbers → Verified Caller IDs, up to 5, for the 30-day trial).
# TWILIO_VERIFY_SERVICE_SID is optional: leave it empty and the app finds or creates a Verify service
# named "DashLane" (the SID is printed in the log so you can paste it here).
TWILIO_ACCOUNT_SID=ACxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxx

# Automatic ID document checks — ID Analyzer (free plan: 100 API credits, no card; 1 credit per scan)
# Sign up at https://portal.idanalyzer.com and copy your API key from the portal.
# Profile: a KYC profile ID from the portal, or a preset: security_none | security_low | security_medium | security_high
# BaseUrl: https://api2.idanalyzer.com (US) or https://api2-eu.idanalyzer.com (EU)
IdCheck__IdAnalyzerApiKey=
IdCheck__Profile=security_medium
IdCheck__BaseUrl=https://api2.idanalyzer.com

# Public support / privacy / safety contact shown on Help, Privacy, Security and Community Standards.
# Leave empty until someone monitors the inbox.
Site__SupportEmail=
