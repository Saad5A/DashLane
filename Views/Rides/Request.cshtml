@model RideRequestViewModel
@{
    ViewData["Title"] = "Request a Ride";
    var form = Model.Form ?? new RideRequestForm();
    var selected = Model.Quotes?.SingleOrDefault(q => q.Tier == form.Tier);
    var cad = System.Globalization.CultureInfo.GetCultureInfo("en-CA");
}
@section Styles {
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/rider-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ride-request.css" asp-append-version="true" />
}
<section class="ride-page rider-workflow stitch-request">
    <partial name="_RideReturnLinks" />
    <partial name="_RideSteps" model="1" />
    <header class="ride-page-heading"><div><span class="ride-eyebrow">Your next journey</span><p>Choose your route, find your fit, and know your fare before you ride.</p></div><a class="ride-secondary" asp-controller="Rides" asp-action="Policy">@Icon.Get("shield",16) Ride policies</a></header>
    <form id="ride-request-form" data-quotes-url="@Url.Action("Quotes", "Rides")" class="ride-grid" asp-controller="Rides" asp-action="Request" method="post">
        <div class="ride-selector stitch-request-selector">
            <div class="ride-card-label"><span class="ride-chip ride-service-pill">Rider service</span><span class="ride-help">Step 01 of 04</span></div><h1 class="ride-editorial-title">Request a Ride</h1><p class="ride-muted">Your route. Your pace. An upfront fare before you set off.</p>
            <div asp-validation-summary="All" class="ride-validation" role="alert"></div>
            <section class="ride-card ride-panel request-section"><div class="ride-section-heading"><h2 class="ride-heading-icon">@Icon.Get("map-pin",20) Your route</h2><span class="ride-chip">Greater Toronto Area</span></div>
                <div class="ride-route-selector">
                    <div class="ride-field"><label asp-for="Form.PickupId">Pickup location</label><select asp-for="Form.PickupId" class="ride-input" required><option value="">Choose a pickup stop</option>@foreach(var place in Model.Places) { <option value="@place.Id">@place.Name — @place.Address</option> }</select><span asp-validation-for="Form.PickupId"></span></div>
                    <div class="ride-field"><label asp-for="Form.DestinationId">Destination</label><select asp-for="Form.DestinationId" class="ride-input" required><option value="">Where would you like to go?</option>@foreach(var place in Model.Places) { <option value="@place.Id">@place.Name — @place.Address</option> }</select><span asp-validation-for="Form.DestinationId"></span></div>
                </div>
                <div class="ride-field-row request-preferences"><div class="ride-field"><label asp-for="Form.Passengers">Passengers</label><input asp-for="Form.Passengers" class="ride-input" min="1" max="6" /><span asp-validation-for="Form.Passengers"></span></div><div class="ride-field"><label asp-for="Form.ScheduledLocal">Departure · Eastern time</label><input asp-for="Form.ScheduledLocal" type="datetime-local" class="ride-input" /><span class="ride-help">Leave empty to ride now. Scheduled trips are previews.</span></div></div>
                <label class="wav-toggle"><input asp-for="Form.RequiresWheelchairAccess" /><span class="wav-toggle-face"><svg width="18" height="18" viewBox="0 0 40 32" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><circle cx="21" cy="5" r="2.5" /><path d="M19 10v9h9l4 8 3-1M19 13h8M15 15a8 8 0 1 0 10 11" /></svg> WAV Ramp Required <span class="wav-check" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="10" cy="10" r="8" /><path d="m6 10 3 3 5-6" /></svg></span></span></label>
            </section>
            <section class="ride-card ride-panel request-section"><div class="ride-section-heading"><h2>Choose your ride</h2><span class="ride-help">Four ways to travel</span></div>
                <fieldset class="m-0 p-0 border-0"><legend class="visually-hidden">Vehicle tier</legend><div class="ride-tiers">
                @foreach(var option in Model.Tiers) {
                    var quote=Model.Quotes?.SingleOrDefault(q=>q.Tier==option.Tier);
                    <label class="ride-tier" data-tier="@option.Tier" for="tier-@option.Tier"><span class="ride-tier-icon"><partial name="_VehicleTierIcon" model="option.Tier" /></span><input asp-for="Form.Tier" type="radio" id="tier-@option.Tier" value="@option.Tier" /><span class="ride-tier-name">@option.Name</span><span class="ride-tier-description">@option.Description</span><span class="tier-disabled-reason" hidden></span><span class="ride-tier-eta">@Icon.Get("car",12) Pickup ETA at driver match</span><span class="ride-tier-footer"><span>@option.Capacity</span><span class="ride-tier-price tabular-nums">@(quote?.Fare.ToString("C",cad) ?? (Model.Quotes == null ? "—" : "Unavailable"))</span></span></label>
                }
                </div><span asp-validation-for="Form.Tier"></span></fieldset>
                <p class="ride-help">Fares update with your route and preferences. The server confirms your price before booking.</p>
            </section>
            <div class="ride-request-actions"><button id="ride-continue" class="ride-primary" type="submit" name="intent" value="continue">Continue to Driver Match @Icon.Get("arrow-right",16)</button></div>
        </div>
        <aside class="ride-aside" aria-label="Route and fare summary">
            <section class="ride-card ride-summary ride-hero-card request-map-panel"><div class="ride-section-heading"><h2>Your journey, mapped.</h2><span class="ride-chip ride-service-pill">Upfront fare</span></div>
                <div id="request-map" class="request-live-map" aria-label="Interactive map of supported GTA stops"></div>
                <p class="ride-help">Click a stop for pickup, then another for destination. Route lines show estimated road corridors, not live traffic.</p>
                <div class="request-map-metrics tabular-nums"><span class="ride-chip" id="route-distance">&mdash; km</span><span class="ride-chip" id="route-duration">&mdash; min</span></div>
                <p id="route-caption" class="ride-help"></p>
                <noscript><p class="ride-notice">Enable JavaScript for the map and live prices, or select your route and use Continue to Driver Match to review a server quote.</p></noscript>
                <input asp-for="Form.ExpectedFare" type="hidden" /><input asp-for="Form.ExpectedSurge" type="hidden" />
                <div id="live-fare-summary" aria-live="polite"><dl class="ride-breakdown"><div><dt>Selected tier</dt><dd id="selected-tier">@(Model.Tiers.FirstOrDefault(t => t.Tier == form.Tier)?.Name)</dd></div><div><dt>Demand multiplier</dt><dd id="selected-surge">@(selected?.SurgeMultiplier.ToString("0.00"))</dd></div><div class="ride-total"><dt>Upfront fare &middot; CAD</dt><dd id="selected-fare" class="tabular-nums">@(selected?.Fare.ToString("C",cad) ?? "—")</dd></div></dl><p id="quote-status" class="ride-help">Choose two different stops to see your fare. It locks when you continue.</p></div>
                <p class="ride-help">@Icon.Get("shield",14) No payment is taken at this step.</p>
            </section>
            <section class="ride-card ride-panel request-guarantee"><h2>@Icon.Get("shield",18) Upfront price protection</h2><p class="ride-help">Review the full quote before continuing. Your confirmed fare is locked through checkout.</p><a asp-controller="Rides" asp-action="Policy">Fare &amp; safety policies →</a></section>
        </aside>
    </form>
</section>

@section Scripts {
    <script id="ride-live-data" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { places = Model.Places, routes = ViewData["LiveRideQuotes"] }, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)))</script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="~/js/ride-request.js" asp-append-version="true"></script>
}
