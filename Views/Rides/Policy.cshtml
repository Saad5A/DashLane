@model IReadOnlyList<RideFareRate>
@{ ViewData["Title"]="Ride Policies"; var cad=System.Globalization.CultureInfo.GetCultureInfo("en-CA"); }
@section Styles {
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/rider-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ride-policy.css" asp-append-version="true" />
}
<section class="ride-page rider-workflow"><partial name="_RideReturnLinks" /><header class="ride-page-heading"><div><span class="ride-eyebrow">Clear fares. Clear expectations.</span><h1>Ride with confidence.</h1><p>Know what your fare covers, when cancellation is free, and where to find support.</p></div><a class="ride-secondary" asp-controller="Rides" asp-action="Request">@Icon.Get("arrow-left",16) Back to your ride</a></header>
<div class="ride-grid"><div class="ride-selector">
    <section class="ride-card ride-panel ride-hero-card" id="fares"><h2>Fare and tier minimums</h2><p class="ride-muted">Your fare combines a base fee, distance, and estimated travel time. Any demand multiplier applies before the tier minimum and eligible promotion.</p><dl class="ride-breakdown tabular-nums">@foreach(var rate in Model) { <div><dt>@RideRouteCatalog.View.Tiers.Single(t=>t.Tier==rate.Tier).Name</dt><dd>@rate.Minimum.ToString("C",cad) CAD minimum</dd></div> }</dl><p class="ride-help">These are the current configured tier minimums. Your route's full quote is shown before you confirm.</p></section>
    <section class="ride-card ride-panel ride-hero-card" id="surge"><h2>Upfront Fare Lock &amp; Surge Transparency</h2><p class="ride-muted">When nearby ride demand exceeds 150% of available drivers, a 1.25×–2.0× demand multiplier may apply. Review the multiplier and full fare before continuing.</p><div class="ride-policy-highlight">@Icon.Get("shield",20)<p>Your confirmed fare and multiplier stay locked through checkout. Later demand changes won't increase your booked fare.</p></div></section>
    <section class="ride-card ride-panel ride-hero-card" id="cancellation"><h2>2-Minute Free Cancellation</h2><dl class="ride-breakdown"><div><dt>Before driver assignment</dt><dd>Free</dd></div><div><dt>Within 2 minutes of assignment</dt><dd>Free</dd></div><div><dt>Driver more than 5 minutes late against pickup ETA</dt><dd>Free</dd></div><div><dt>After the free window, without a late-driver exception</dt><dd class="tabular-nums">$5.00 CAD</dd></div></dl><p class="ride-help">The trip page displays the current cancellation fee. The server checks it again before accepting cancellation, so you must reconfirm if it changes.</p></section>
    <section class="ride-card ride-panel ride-hero-card" id="promotions"><h2>Making your promotion count</h2><p class="ride-muted">Apply one active code to a locked fare of $15.00 CAD or more. Eligibility depends on validity dates, account restrictions, and remaining redemptions. Checkout verifies the code again before saving the booking.</p></section>
    <section class="ride-card ride-panel ride-hero-card" id="safety"><h2>Safety &amp; Accessibility</h2><p class="ride-muted">Eligible drivers have verified licences and phone numbers and have passed a background check. Choose the wheelchair-accessible tier for a ramp-equipped vehicle and indicate any assistance in your pickup notes. Chat is available from assignment until the trip ends, and incident reports are recorded with your trip.</p><div class="ride-notice">The SOS tool is a simulation. It records coordinates and a simulated notification; it does not contact anyone or dispatch emergency services. Call 911 in a real emergency.</div><a asp-controller="Home" asp-action="Help">Visit the Help Centre →</a></section>
</div><aside class="ride-aside"><nav class="ride-card ride-panel ride-policy-nav" aria-label="On this page"><h2>Good to know</h2><a href="#fares">Fares &amp; minimums</a><a href="#surge">Surge &amp; price lock</a><a href="#cancellation">Cancellation</a><a href="#promotions">Promotion codes</a><a href="#safety">Rider safety</a></nav><section class="ride-card ride-panel"><span class="ride-chip">Test environment</span><h2>A checkout you can explore.</h2><p class="ride-help">Card and wallet transactions are simulated. No real payment details or money are needed.</p></section></aside></div></section>
