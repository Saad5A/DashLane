@model CheckoutViewModel
@{ ViewData["Title"] = "Guaranteed Fare & Checkout"; var fare=Model.Fare; var draft=Model.Draft; var cad=System.Globalization.CultureInfo.GetCultureInfo("en-CA"); }
@section Styles {
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/rider-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ride-checkout.css" asp-append-version="true" />
}
<section class="ride-page rider-workflow stitch-checkout">
    <partial name="_RideReturnLinks" />
    <partial name="_RideSteps" model="3" />
    <header class="ride-page-heading"><div><span class="ride-eyebrow">One last look</span><h1>Your fare. All upfront.</h1><p>Review the details, choose a test payment method, and you're ready to go.</p></div><span class="ride-chip checkout-lock">@Icon.Get("shield",16) Price locked</span></header>
    <form class="ride-grid" asp-controller="Rides" asp-action="Checkout" method="post">
        <input asp-for="Input.DraftId" type="hidden" /><input asp-for="Input.ExpectedTotal" type="hidden" />
        <div class="ride-selector"><div asp-validation-summary="All" class="ride-validation" role="alert"></div>
            <section class="ride-card ride-panel ride-hero-card"><div class="ride-card-label"><span class="ride-chip ride-service-pill">Checkout</span><span class="ride-help">Step 03 of 04</span></div><div class="ride-section-heading"><h2>A smooth finish to your booking.</h2><span class="ride-chip">Test checkout</span></div>
                <fieldset class="border-0 p-0 m-0"><legend class="visually-hidden">Choose a simulated payment method</legend><div class="checkout-methods"><label class="checkout-method" for="payment-card"><input asp-for="Input.Method" type="radio" value="Card" id="payment-card" /><span>@Icon.Get("card",22)<strong>Test card</strong><small>Simulated card payment</small></span></label><label class="checkout-method" for="payment-wallet"><input asp-for="Input.Method" type="radio" value="Wallet" id="payment-wallet" /><span>@Icon.Get("shield",22)<strong>Test wallet</strong><small>Simulated wallet payment</small></span></label></div></fieldset>
                <p class="ride-help">No real card details or money required. This checkout records a test transaction only.</p><div class="checkout-guarantee">@Icon.Get("shield",20)<div><strong>2-minute free cancellation</strong><p>Free before assignment and within 2 minutes of assignment. Late-driver exceptions also apply.</p></div></div>
            </section>
            <section class="ride-card ride-panel"><h2>A little something off</h2><div class="checkout-promo"><div class="ride-field"><label asp-for="Input.PromoCode">Promotion code</label><input asp-for="Input.PromoCode" class="ride-input" maxlength="32" placeholder="Enter your code" autocomplete="off" /></div><button class="ride-secondary" type="submit" name="intent" value="promo">Apply code</button></div><span asp-validation-for="Input.PromoCode"></span><p class="ride-help">One eligible code per trip, on a locked fare of $15 CAD or more. Clear the code and apply again to remove it.</p>@if(fare.Discount > 0) { <p class="ride-chip is-ok">Promotion applied · @fare.Discount.ToString("C",cad) saved</p> }</section>
            <section class="ride-card ride-panel"><div class="ride-section-heading"><h2>Your journey</h2><a asp-controller="Rides" asp-action="Confirm">Edit details</a></div><div class="ride-route-summary"><p>@Icon.Get("map-pin",14) @draft.Pickup.Name</p><p>@Icon.Get("arrow-right",14) @draft.Destination.Name</p></div><dl class="ride-breakdown"><div><dt>Driver</dt><dd>@draft.Confirmation!.DriverName</dd></div><div><dt>Vehicle</dt><dd>@draft.Confirmation.Vehicle</dd></div><div><dt>Passengers</dt><dd>@draft.Passengers</dd></div><div><dt>Vehicle tier</dt><dd>@RideRouteCatalog.View.Tiers.Single(t=>t.Tier==draft.Quote.Tier).Name</dd></div>@if(!string.IsNullOrWhiteSpace(draft.Confirmation.PickupInstructions)) { <div><dt>Pickup instructions</dt><dd>@draft.Confirmation.PickupInstructions</dd></div> }</dl></section>
            <div class="ride-card ride-panel checkout-book-action"><button class="ride-primary" type="submit" name="intent" value="pay" disabled="@(!Model.CanPay)">Confirm &amp; Book Ride @Icon.Get("arrow-right",16)</button><p class="ride-help">Simulated payment only. No real money is charged.</p></div>
        </div>
        <aside class="ride-aside"><section class="ride-card ride-summary checkout-fare ride-hero-card"><div class="ride-route-summary checkout-corridor"><span class="ride-eyebrow">Your confirmed route</span><p>@draft.Pickup.Name @Icon.Get("arrow-right",14) @draft.Destination.Name</p><p class="ride-help tabular-nums">@draft.Route.DistanceKm km · approximately @draft.Route.DurationMin minutes</p></div><div class="ride-section-heading"><h2>Guaranteed Fare Breakdown</h2><span class="ride-chip ride-service-pill">Price locked</span></div>
            @if(draft.Quote.SurgeMultiplier > 1) { <span class="ride-chip is-warning">@draft.Quote.SurgeMultiplier.ToString("0.00")× demand multiplier · locked</span> }<dl class="ride-breakdown tabular-nums"><div><dt>Base fare</dt><dd>@fare.Base.ToString("C",cad)</dd></div><div><dt>Distance · @draft.Route.DistanceKm km</dt><dd>@fare.Distance.ToString("C",cad)</dd></div><div><dt>Time · @draft.Route.DurationMin min</dt><dd>@fare.Duration.ToString("C",cad)</dd></div><div><dt>Surge adjustment · @draft.Quote.SurgeMultiplier.ToString("0.00")×</dt><dd>@fare.Surge.ToString("C",cad)</dd></div><div><dt>Tier minimum adjustment</dt><dd>@fare.MinimumAdjustment.ToString("C",cad)</dd></div><div><dt>Locked fare</dt><dd>@fare.LockedTotal.ToString("C",cad)</dd></div><div><dt>Promotion discount</dt><dd>−@fare.Discount.ToString("C",cad)</dd></div><div><dt>Included HST · 13%</dt><dd>@fare.Tax.ToString("C",cad)</dd></div><div class="ride-total checkout-total"><dt>Total · CAD</dt><dd>@fare.Total.ToString("C",cad)</dd></div></dl>
            <p class="ride-help">The confirmed fare includes HST. Later demand changes won't increase your locked price.</p>@if(Model.Notice != null) { <p class="ride-notice" role="status">@Model.Notice</p> }
            <p class="checkout-terms">Free cancellation within 2 minutes of assignment. <a asp-controller="Rides" asp-action="Policy" asp-fragment="cancellation">View cancellation policy</a></p>
        </section></aside>
    </form>
</section>
