@model RideConfirmationViewModel
@{ ViewData["Title"] = "Driver & Pickup Details"; var draft = Model.Draft; var cad = System.Globalization.CultureInfo.GetCultureInfo("en-CA"); }
@section Styles {
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/rider-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ride-confirm.css" asp-append-version="true" />
}
<section class="ride-page rider-workflow stitch-confirm">
    <partial name="_RideReturnLinks" />
    <partial name="_RideSteps" model="2" />
    <header class="ride-page-heading"><div><span class="ride-eyebrow">Meet your match</span><h1>Driver Match &amp; Pickup Instructions</h1><p>Inspect your vehicle, choose a driver, and make pickup a little easier.</p></div><a class="ride-secondary" asp-controller="Rides" asp-action="Request" asp-route-edit="true">@Icon.Get("arrow-left",16) Edit route</a></header>
    <form class="ride-grid" asp-controller="Rides" asp-action="Confirm" method="post">
        <input asp-for="Input.DraftId" type="hidden" />
        <div class="ride-selector"><div asp-validation-summary="All" class="ride-validation" role="alert"></div>
            <section class="ride-card ride-panel ride-hero-card"><div class="ride-card-label"><span class="ride-chip ride-service-pill">Driver match</span><span class="ride-help">Step 02 of 04</span></div><div class="ride-section-heading"><h2>Your journey starts with a good match.</h2><span class="ride-chip">@Model.Drivers.Count @(Model.Drivers.Count == 1 ? "match" : "matches")</span></div>
                @if(Model.Drivers.Count == 0) { <div class="ride-empty">@Icon.Get("car",32)<h3>No eligible drivers right now</h3><p class="ride-muted">Try another vehicle tier, adjust your route, or check again later.</p><a class="ride-secondary" asp-controller="Rides" asp-action="Request" asp-route-edit="true">Back to your route</a></div> }
                @foreach(var driver in Model.Drivers) {
                    <article class="confirm-driver"><label class="confirm-profile" for="driver-@driver.Id">
                        @if(driver.PhotoUrl != null) { <img src="@driver.PhotoUrl" alt="" width="56" height="56" /> } else { <span class="confirm-avatar" aria-hidden="true">@driver.Name.FirstOrDefault()</span> }
                        <span class="confirm-profile-info"><strong>@driver.Name</strong><span class="d-block ride-help">@if(driver.Rating is {} rating) { <span class="confirm-star">★</span> @rating.Average.ToString("0.00") <span>· @rating.Count ratings</span> } else { <span>No ratings yet</span> }</span></span><input asp-for="Input.DriverId" type="radio" id="driver-@driver.Id" value="@driver.Id" required aria-label="Choose @driver.Name" />
                    </label><div class="confirm-pills"><span class="ride-chip is-ok">@Icon.Get("shield",12) Licence verified</span><span class="ride-chip is-ok">Background checked</span><span class="ride-chip is-ok">Phone verified</span></div>
                    <dl class="confirm-specs confirm-vehicle-tray"><div><dt>Vehicle</dt><dd>@driver.Year @driver.Make @driver.Model</dd></div><div><dt>Licence plate</dt><dd><span class="confirm-plate">@driver.Plate</span></dd></div><div><dt>Passenger capacity</dt><dd>@driver.Capacity seats</dd></div><div><dt>Estimated pickup</dt><dd class="tabular-nums">@driver.Approach.EtaMinutes min away</dd></div></dl><div class="confirm-tier-row"><partial name="_VehicleTierIcon" model="draft.Quote.Tier" /><span>@RideRouteCatalog.View.Tiers.Single(t=>t.Tier==draft.Quote.Tier).Name</span><span class="ride-chip">@driver.Approach.EtaMinutes min pickup ETA</span></div><p class="ride-help">@(driver.Accessible ? "Ramp-equipped wheelchair access" : "No wheelchair ramp registered")</p></article>
                }
            </section>
            <section class="ride-card ride-panel"><h2>Make pickup simple</h2><div class="ride-field"><label asp-for="Input.PickupInstructions">Pickup instructions</label><textarea asp-for="Input.PickupInstructions" class="confirm-field" rows="3" maxlength="200" placeholder="An entrance, a landmark, or a little extra assistance…"></textarea><span asp-validation-for="Input.PickupInstructions"></span></div><div class="ride-field"><label asp-for="Input.DriverNote">Pre-trip note to your selected driver</label><textarea asp-for="Input.DriverNote" class="confirm-field" rows="3" maxlength="200" placeholder="Anything else your driver should know?"></textarea><span asp-validation-for="Input.DriverNote"></span></div><p class="ride-help">Keep each note to 200 characters. Avoid sharing sensitive personal details.</p></section>
        </div>
        <section class="ride-card ride-panel confirm-policy"><h2>@Icon.Get("shield",20) DashLane 2-Minute Cancellation Rule</h2><p class="ride-muted">Cancel free before assignment or within 2 minutes of assignment. After the free window, a $5.00 CAD fee applies unless the late-driver exception applies.</p><a asp-controller="Rides" asp-action="Policy" asp-fragment="cancellation">View complete ride &amp; safety policies →</a></section>
        <aside class="ride-aside"><section class="ride-card ride-summary ride-hero-card"><div class="ride-section-heading"><h2>Your confirmed route</h2><span class="ride-chip">Fare locked</span></div><partial name="_RideMap" model="draft.Route.Points" /><div class="ride-route-summary"><p>@Icon.Get("map-pin",14) @draft.Pickup.Name</p><p>@Icon.Get("arrow-right",14) @draft.Destination.Name</p></div><dl class="ride-breakdown"><div><dt>Distance / time</dt><dd>@draft.Route.DistanceKm km · @draft.Route.DurationMin min</dd></div><div><dt>Passengers</dt><dd>@draft.Passengers</dd></div><div><dt>Demand multiplier · locked</dt><dd>@draft.Quote.SurgeMultiplier.ToString("0.00")×</dd></div><div class="ride-total"><dt>Locked fare · CAD</dt><dd class="tabular-nums">@draft.Quote.Fare.ToString("C",cad)</dd></div></dl><div class="confirm-cta-stack"><a class="ride-secondary" asp-controller="Rides" asp-action="Request" asp-route-edit="true">@Icon.Get("arrow-left",16) Change Route/Tier</a><button class="ride-primary" type="submit" disabled="@(Model.Drivers.Count == 0)">Proceed to Checkout @Icon.Get("arrow-right",16)</button></div><p class="ride-help">Free cancellation before assignment and within 2 minutes of assignment. <a asp-controller="Rides" asp-action="Policy" asp-fragment="cancellation">See the policy.</a></p></section></aside>
    </form>
</section>
