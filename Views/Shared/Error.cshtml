@model ErrorViewModel
@{
    ViewData["Title"] = T("Something went wrong") + " — DashLane";
    Layout = "_AuthLayout";
}

<div class="error-page">
    <p class="eyebrow eyebrow-accent">@T("Error")</p>
    <h1 class="sheet-title">@T("Something went wrong on our side.")</h1>
    <p class="sheet-lede">@T("The request couldn't be completed. Try again in a moment — if it keeps happening, include the request ID below when you contact us.")</p>
    @if (Model.ShowRequestId)
    {
        <p class="error-code">Request ID · @Model.RequestId</p>
    }
    <div class="hero-actions error-actions">
        <a class="btn btn-primary" href="@Url.Action("Index", "Home")">@T("Back to home")</a>
    </div>
</div>
