@{
    var step = ViewData["Step"] as int? ?? 1;
    var actions = new[] { "Onboarding", "PostRoute", "PostDetails", "Publish" };
    var labels = new[]
    {
        "Vehicle & License",
        "Route & Stops",
        "Instructions & Fares",
        "Publish & Dispatch"
    };
}

<nav class="post-progress ride-card" aria-label="Post a ride progress">
    <ol>
        @for (var i = 0; i < labels.Length; i++)
        {
            var n = i + 1;
            <li class="@(n < step ? "is-complete" : "")" aria-current="@(n == step ? "step" : null)">
                <span>@if(n < step) { @Icon.Get("check", 13) } else { @n.ToString("00") }</span>
                @if (n < step) { <a asp-controller="Driver" asp-action="@actions[i]">@labels[i]</a> }
                else { <span>@labels[i]</span> }
            </li>
        }
    </ol>
</nav>
