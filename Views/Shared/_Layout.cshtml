<!DOCTYPE html>
@inject MembershipService NavbarMembership
@{
    Member? navbarMember = null;
    if (User.Identity?.IsAuthenticated == true &&
        int.TryParse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var navbarMemberId))
    {
        navbarMember = await NavbarMembership.FindAsync(navbarMemberId);
    }
    var navbarName = navbarMember?.FullName ?? User.Identity?.Name ?? "";
    var navbarParts = navbarName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var navbarInitials = navbarParts.Length == 0 ? "?" :
        string.Concat(navbarParts.Take(1).Concat(navbarParts.Length > 1 ? navbarParts.TakeLast(1) : Array.Empty<string>()).Select(p => p[..1])).ToUpperInvariant();
    var isHome = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Home", StringComparison.OrdinalIgnoreCase) &&
        string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Index", StringComparison.OrdinalIgnoreCase);
}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DashLane</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DashLane.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(ViewData["Dashboard"] as bool? == true ? "dashboard-shell" : "")">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">DashLane</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark @(isHome ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index" aria-current="@(isHome ? "page" : null)">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Rides" asp-action="Request">Request a Ride</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Driver" asp-action="Onboarding">Post a Ride</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="navbar-profile" asp-controller="Home" asp-action="Profile" title="Edit profile" aria-label="Edit your profile">
                        @if (!string.IsNullOrWhiteSpace(navbarMember?.PhotoFileName))
                        {
                            <img src="@Url.Action("Photo", "Home")" alt="" width="40" height="40" />
                        }
                        else
                        {
                            <span aria-hidden="true">@navbarInitials</span>
                        }
                    </a>
                }
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - DashLane - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
