@model Member
@{
    ViewData["Title"] = T("Verify your identity") + " — DashLane";
    ViewData["Step"] = 4;
    Layout = "_AuthLayout";
    var notice = ViewData["Notice"] as string;
    var noticeOk = ViewData["NoticeKind"] as string == "ok";
    var hasFile = !string.IsNullOrEmpty(Model.DocumentFileName);
    var savedIsPdf = hasFile && Model.DocumentFileName!.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase);
    var documents = new[]
    {
        ("car", "Driver's Licence", T("Needed to offer rides later")),
        ("book", "Passport", T("Fine for booking seats")),
        ("id-card", "Provincial Photo ID", T("Fine for booking seats")),
    };
    var (checkClass, checkLabel) = Model.DocumentCheckDecision switch
    {
        "accept" => ("tag-ok", T("Passed automatic check")),
        "review" => ("tag-accent", T("Needs manual review")),
        "reject" => ("tag-err", T("Didn't pass")),
        _ => ("", T("Not checked automatically"))
    };
}

<div class="setup">
    <partial name="_SetupSteps" model="Model" />

    <div class="sheet">
        <header class="sheet-head rise">
            <p class="eyebrow">@T("Step") 04 / 05</p>
            <h1 class="sheet-title">@T("Verify your identity")</h1>
            <p class="sheet-lede">@T("Upload one Canadian government ID. It's stored privately on your account and never shown on your profile.")</p>
        </header>

        <p id="flow-status" class="notice notice-err" role="status" aria-live="polite" hidden="@(TempData["GateNotice"] is not string)">@TempData["GateNotice"]</p>

        <div class="sheet-grid">
            <form class="card form-card rise rise-1" method="post" enctype="multipart/form-data" action="@Url.Action("Identity", "Home")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="documentType" id="documentType" value="@Model.DocumentType" />

                @if (!string.IsNullOrEmpty(notice))
                {
                    <div class="form-notice"><p class="notice @(noticeOk ? "notice-ok" : "notice-err")" role="status">@notice</p></div>
                }

                <section class="form-section is-stacked">
                    <div>
                        <h2 class="fs-title">@T("Document type")</h2>
                        <p class="fs-sub">@T("Planning to drive? Use your licence.")</p>
                    </div>
                    <div class="options options-3" id="docTypeGroup" role="radiogroup" aria-label="@T("Document type")" data-radio-group="documentType">
                        @foreach (var (icon, name, sub) in documents)
                        {
                            <div class="option option-stack doc-card" role="radio" aria-checked="false" tabindex="-1" data-value="@name">
                                <span class="option-icon">@Icon.Get(icon, 16)</span>
                                <span class="option-body">
                                    <span class="option-title">@T(name)</span>
                                    <span class="option-sub">@sub</span>
                                </span>
                                <span class="option-mark">@Icon.Get("check", 11)</span>
                            </div>
                        }
                    </div>
                </section>

                <section class="form-section is-stacked">
                    <div>
                        <h2 class="fs-title">@T("Upload")</h2>
                        <p class="fs-sub">@T("Photo page or front side. All four corners visible, no glare. Photos get an automatic check; PDFs are reviewed manually.")</p>
                    </div>

                    <label class="drop" id="doc-drop" for="documentFile">
                        <span class="drop-icon">@Icon.Get("upload", 18)</span>
                        <span class="drop-title" id="doc-drop-title">@T("Drop a file or") <u>@T("browse")</u></span>
                        <span class="drop-sub" id="doc-drop-sub">@T("JPG, PNG, WebP or PDF · up to 10 MB")</span>
                        <input class="file-input" id="documentFile" name="document" type="file" accept="image/jpeg,image/png,image/webp,application/pdf" />
                    </label>

                    <figure class="doc-preview" id="doc-preview" hidden="@(!hasFile)" data-label-new="@T("New file — not uploaded yet")" data-label-saved="@T("Saved document")">
                        <figcaption class="doc-preview-bar">
                            @Icon.Get("file", 15, "subtle")
                            <span class="name" id="doc-preview-name">@(hasFile ? Model.DocumentFileName : "")</span>
                            <span class="tag" id="doc-preview-state">@T("Saved document")</span>
                            @if (hasFile)
                            {
                                <a class="btn btn-ghost btn-sm" id="doc-preview-open" href="@Url.Action("Document", "Home")" target="_blank" rel="noopener">@Icon.Get("arrow-up-right", 13) @T("Open")</a>
                            }
                            <button type="button" class="btn btn-ghost btn-sm" id="doc-preview-clear" hidden>@T("Clear")</button>
                        </figcaption>
                        <div class="doc-preview-body">
                            <img id="doc-preview-img" alt="@T("Preview of your ID document")" src="@(hasFile && !savedIsPdf ? Url.Action("Document", "Home") : null)" hidden="@(!hasFile || savedIsPdf)" />
                            <iframe id="doc-preview-pdf" title="@T("Preview of your ID document")" src="@(savedIsPdf ? Url.Action("Document", "Home") : null)" hidden="@(!savedIsPdf)"></iframe>
                        </div>
                    </figure>

                    @if (hasFile)
                    {
                        <div class="file-row">
                            <span class="tag @checkClass">@checkLabel</span>
                            <span class="check-summary">@(string.IsNullOrWhiteSpace(Model.DocumentCheckSummary) ? T("No automatic check has run on this file.") : CheckSummary(Model.DocumentCheckSummary))</span>
                            <button type="submit" class="btn btn-danger btn-sm" name="removeDocument" value="true" formnovalidate>@Icon.Get("trash", 14) @T("Remove")</button>
                        </div>
                    }
                </section>

                <div class="form-actions">
                    <a class="btn btn-ghost" href="@Url.Action("Contact", "Home")">@Icon.Get("arrow-left", 16) @T("Back")</a>
                    <span class="grow"></span>
                    <span class="aside">@Icon.Get("lock", 13) @T("Private to your account")</span>
                    <button class="btn btn-primary" type="submit" data-busy>
                        <span>@T("Submit")</span>
                        @Icon.Get("arrow-right", 16, "i-nudge")
                    </button>
                </div>
            </form>

            <aside class="card side-card rise rise-2">
                <p class="side-title">@Icon.Get("shield", 15) @T("Before you upload")</p>
                <ul class="checks">
                    <li class="status-line"><span class="dot dot-ok"></span>@T("All four corners in frame")</li>
                    <li class="status-line"><span class="dot dot-ok"></span>@T("No flash glare over text")</li>
                    <li class="status-line"><span class="dot dot-ok"></span>@T("Photo and numbers are sharp")</li>
                    <li class="status-line"><span class="dot dot-err"></span>@T("No photocopies or screenshots")</li>
                </ul>
                <p class="side-text">@T("The automatic check reads the document and compares it with the legal name and date of birth you entered:") <strong>@(string.IsNullOrWhiteSpace(Model.LegalName) ? T("not entered yet") : Model.LegalName)</strong>.</p>
            </aside>
        </div>
    </div>
</div>
