@model Member
@{
    ViewData["Title"] = T("Verify your phone") + " — DashLane";
    ViewData["Step"] = 3;
    Layout = "_AuthLayout";
    var notice = ViewData["Notice"] as string;
    var noticeOk = ViewData["NoticeKind"] as string == "ok";
    var smsReady = ViewData["SmsReady"] as bool? == true;
    var localNumber = Model.PhoneNumber is { Length: > 2 } ? Model.PhoneNumber[2..] : Model.PhoneNumber;
    var codePending = !Model.PhoneVerified && Model.PhoneCodeExpiresUtc is { } expires && expires > DateTime.UtcNow;
}

<div class="setup">
    <partial name="_SetupSteps" model="Model" />

    <div class="sheet">
        <header class="sheet-head rise">
            <p class="eyebrow">@T("Step") 03 / 05</p>
            <h1 class="sheet-title">@T("Verify your phone")</h1>
            <p class="sheet-lede">@T("We use your number to secure your account. It's never shown to other members.")</p>
        </header>

        <p id="flow-status" class="notice notice-err" role="status" aria-live="polite" hidden="@(TempData["GateNotice"] is not string)">@TempData["GateNotice"]</p>

        <div class="sheet-grid">
            <div class="card form-card rise rise-1">
                <form id="contact-form" method="post" action="@Url.Action("Contact", "Home")" novalidate>
                    @Html.AntiForgeryToken()
                </form>

                @if (!string.IsNullOrEmpty(notice))
                {
                    <div class="form-notice"><p class="notice @(noticeOk ? "notice-ok" : "notice-err")" role="status">@notice</p></div>
                }
                else if (!smsReady && !Model.PhoneVerified)
                {
                    <div class="form-notice"><p class="notice notice-err" role="status">@T("SMS codes aren't set up yet. Add TWILIO_ACCOUNT_SID and TWILIO_AUTH_TOKEN to .env and restart the app.")</p></div>
                }

                <section class="form-section is-stacked">
                    <div class="field">
                        <div class="label-row">
                            <label class="label" for="phone-number">@T("Mobile number")</label>
                            @if (Model.PhoneVerified)
                            {
                                <span class="tag tag-ok">@Icon.Get("check", 12) @T("Verified")</span>
                            }
                            else if (codePending)
                            {
                                <span class="tag tag-accent"><span class="dot dot-live"></span> @T("Code sent")</span>
                            }
                        </div>
                        <div class="phone">
                            <span class="phone-cc"><span class="flag" aria-hidden="true"></span>+1</span>
                            <input class="input" id="phone-number" form="contact-form" name="phoneNumber" type="tel" inputmode="tel" autocomplete="tel-national" placeholder="416 555 0199" value="@localNumber" aria-describedby="phone-hint" />
                            <button class="btn btn-secondary btn-sm" form="contact-form" type="submit" name="intent" value="send" data-busy>
                                @Icon.Get("message", 14)
                                <span>@(codePending ? T("Resend") : T("Send code"))</span>
                            </button>
                        </div>
                        <p class="hint" id="phone-hint">@T("Canadian mobile numbers only. Standard message rates may apply.")</p>
                    </div>
                </section>

                <section class="form-section is-stacked">
                    <div class="field">
                        <div class="label-row">
                            <label class="label" for="otp-code">@T("6-digit code")</label>
                            <span class="label-aside">@T("Expires after 10 minutes")</span>
                        </div>
                        <input class="input otp" id="otp-code" form="contact-form" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" placeholder="······" aria-label="@T("6-digit code")" autofocus="@codePending" />
                        <p class="status-line">
                            @if (Model.PhoneVerified)
                            {
                                <span class="dot dot-ok"></span><span>@T("This number is already verified.")</span>
                            }
                            else if (codePending)
                            {
                                <span class="dot dot-live"></span><span>@T("Check your messages, then enter the code.")</span>
                            }
                            else
                            {
                                <span class="dot dot-off"></span><span>@T("Send a code to your number first.")</span>
                            }
                        </p>
                    </div>
                </section>

                <div class="form-actions">
                    <a class="btn btn-ghost" href="@Url.Action("Profile", "Home")">@Icon.Get("arrow-left", 16) @T("Back")</a>
                    <span class="grow"></span>
                    @if (Model.PhoneVerified)
                    {
                        <a class="btn btn-primary" href="@Url.Action("Identity", "Home")">
                            <span>@T("Continue")</span>
                            @Icon.Get("arrow-right", 16, "i-nudge")
                        </a>
                    }
                    else
                    {
                        <button class="btn btn-primary" form="contact-form" type="submit" name="intent" value="verify" data-busy>
                            <span>@T("Verify & continue")</span>
                            @Icon.Get("arrow-right", 16, "i-nudge")
                        </button>
                    }
                </div>
            </div>

            <aside class="card side-card rise rise-2">
                <p class="side-title">@Icon.Get("mail", 15) @T("Account email")</p>
                <p class="side-text">@T("Account messages go to this address.")</p>
                <dl class="kv">
                    <div><dt>@T("Email")</dt><dd title="@Model.Email">@Model.Email</dd></div>
                    <div><dt>@T("Phone")</dt><dd>@(Model.PhoneVerified ? T("Verified") : T("Not verified"))</dd></div>
                    <div><dt>@T("SMS delivery")</dt><dd>@(smsReady ? T("Connected") : T("Not set up"))</dd></div>
                </dl>
            </aside>
        </div>
    </div>
</div>
