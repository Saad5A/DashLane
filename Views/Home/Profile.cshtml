@model Member
@{
    ViewData["Title"] = T("Profile") + " — DashLane";
    ViewData["Step"] = 2;
    Layout = "_AuthLayout";
    var notice = ViewData["Notice"] as string;
    var chosenLanguages = Model.LanguageList;
    var chosenPreferences = Model.PreferenceList;
    var defaultLanguages = new[] { "English", "French", "Spanish", "Mandarin", "Punjabi", "Arabic" };
    var allLanguages = defaultLanguages.Concat(chosenLanguages.Where(l => !defaultLanguages.Contains(l, StringComparer.OrdinalIgnoreCase))).ToList();
    var preferences = new[]
    {
        ("message", "Conversation", "Chatty when spoken to"),
        ("headphones", "Audio", "Podcasts & Low music"),
        ("paw", "Pets", "Pet-friendly (in carrier)"),
        ("no-smoking", "Smoking", "Strictly no smoking"),
    };
    var hasPhoto = !string.IsNullOrEmpty(Model.PhotoFileName);
    var hasBio = !string.IsNullOrWhiteSpace(Model.Bio);
}

<div class="setup">
    <partial name="_SetupSteps" model="Model" />

    <div class="sheet">
        <header class="sheet-head rise">
            <p class="eyebrow">@T("Step") 02 / 05</p>
            <h1 class="sheet-title">@T("Your public profile")</h1>
            <p class="sheet-lede">@T("This is what drivers and riders see before they share a car with you. Keep it short and friendly.")</p>
        </header>

        <p id="flow-status" class="notice notice-err" role="status" aria-live="polite" hidden="@(TempData["GateNotice"] is not string)">@TempData["GateNotice"]</p>

        <div class="sheet-grid">
            <form id="profile-form" class="card form-card rise rise-1" method="post" enctype="multipart/form-data" action="@Url.Action("Profile", "Home")">
                @Html.AntiForgeryToken()
                <input type="hidden" name="languages" id="languagesField" value="@Model.Languages" />
                <input type="hidden" name="preferences" id="preferencesField" value="@Model.Preferences" />

                @if (!string.IsNullOrEmpty(notice))
                {
                    <div class="form-notice"><p class="notice @(ViewData["NoticeKind"] as string == "ok" ? "notice-ok" : "notice-err")" role="status">@notice</p></div>
                }

                <section class="form-section is-stacked">
                    <div>
                        <h2 class="fs-title">@T("Photo")</h2>
                        <p class="fs-sub">@T("A clear, recent photo of your face. JPG, PNG or WebP.")</p>
                    </div>
                    <div class="avatar-row">
                        <div class="avatar">
                            @Icon.Get("user", 28)
                            <img id="avatarImage" data-avatar-preview alt="" src="@(hasPhoto ? Url.Action("Photo", "Home") : null)" hidden="@(!hasPhoto)" />
                        </div>
                        <div class="avatar-actions">
                            <button type="button" class="btn btn-secondary btn-sm" data-photo-pick="photoUploadInput">@Icon.Get("upload", 14) @T("Upload")</button>
                            <button type="button" class="btn btn-ghost btn-sm" data-photo-pick="photoCameraInput">@Icon.Get("camera", 14) @T("Take photo")</button>
                            @if (hasPhoto)
                            {
                                <button type="submit" class="btn btn-danger btn-sm" id="removePhotoBtn" name="removePhoto" value="true" formnovalidate>@Icon.Get("trash", 14) @T("Remove")</button>
                            }
                        </div>
                        <input class="file-input" accept="image/png, image/jpeg, image/webp" id="photoUploadInput" name="photo" type="file" tabindex="-1" />
                        <input class="file-input" accept="image/*" capture="environment" id="photoCameraInput" type="file" tabindex="-1" />
                    </div>
                </section>

                <section class="form-section is-stacked">
                    <div class="field">
                        <div class="label-row">
                            <label class="label" for="bioInput">@T("Bio")</label>
                            <span class="counter" id="charCount">@(Model.Bio?.Length ?? 0) / 300</span>
                        </div>
                        <textarea class="textarea" id="bioInput" name="bio" maxlength="300" rows="4" required placeholder="@T("Weekend commuter between Ottawa and Montréal. Happy to share the aux, or ride in silence.")">@Model.Bio</textarea>
                    </div>
                </section>

                <section class="form-section is-stacked">
                    <div>
                        <h2 class="fs-title">@T("Languages")</h2>
                        <p class="fs-sub">@T("Which languages are you comfortable chatting in?")</p>
                    </div>
                    <div class="chips" id="languageContainer">
                        @foreach (var language in allLanguages)
                        {
                            var on = chosenLanguages.Contains(language, StringComparer.OrdinalIgnoreCase);
                            <button type="button" class="chip lang-pill" data-value="@language" aria-pressed="@(on ? "true" : "false")">@Icon.Get("check", 14, "chip-check")<span>@T(language)</span></button>
                        }
                        <button type="button" class="chip chip-dashed" id="addLangBtn">@Icon.Get("plus", 14) @T("Other")</button>
                    </div>
                    <div class="inline-add" id="custom-lang-row" hidden>
                        <input class="input" id="customLangInput" type="text" maxlength="40" placeholder="@T("e.g. Tagalog")" aria-label="@T("Language name")" />
                        <button type="button" class="btn btn-secondary" id="customLangSave">@T("Add")</button>
                    </div>
                </section>

                <section class="form-section is-stacked">
                    <div>
                        <h2 class="fs-title">@T("Ride preferences")</h2>
                        <p class="fs-sub">@T("Set expectations before anyone gets in the car.")</p>
                    </div>
                    <div class="options options-2">
                        @foreach (var (icon, title, value) in preferences)
                        {
                            var on = chosenPreferences.Contains(value);
                            <button type="button" class="option pref-card @(on ? "is-selected" : "")" data-value="@value" aria-pressed="@(on ? "true" : "false")">
                                <span class="option-icon">@Icon.Get(icon, 16)</span>
                                <span class="option-body">
                                    <span class="option-title">@T(title)</span>
                                    <span class="option-sub">@T(value)</span>
                                </span>
                                <span class="option-mark">@Icon.Get("check", 11)</span>
                            </button>
                        }
                    </div>
                </section>

                <div class="form-actions">
                    <a class="btn btn-ghost" href="@Url.Action("AboutYou", "Home")">@Icon.Get("arrow-left", 16) @T("Back")</a>
                    <span class="grow"></span>
                    <button class="btn btn-primary" type="submit" data-busy>
                        <span>@T("Continue")</span>
                        @Icon.Get("arrow-right", 16, "i-nudge")
                    </button>
                </div>
            </form>

            <aside class="card preview rise rise-2" aria-label="@T("Profile preview")">
                <div class="preview-label">
                    <span class="eyebrow">@T("Preview")</span>
                    <span class="status-line"><span class="dot dot-live"></span>@T("Live")</span>
                </div>
                <div class="preview-id">
                    <div class="avatar avatar-lg">
                        @Icon.Get("user", 24)
                        <img id="previewAvatar" data-avatar-preview alt="" src="@(hasPhoto ? Url.Action("Photo", "Home") : null)" hidden="@(!hasPhoto)" />
                    </div>
                    <div>
                        <h2 class="preview-name" id="previewName">@Model.PublicName</h2>
                        <p class="preview-city">@Icon.Get("map-pin", 12)<span id="previewCity">@(string.IsNullOrWhiteSpace(Model.HomeCity) ? T("City not set") : Model.HomeCity)</span></p>
                    </div>
                </div>
                <div class="preview-badges">
                    <span class="tag @(Model.PhoneVerified ? "tag-ok" : "")">@Icon.Get(Model.PhoneVerified ? "check" : "phone", 12) @(Model.PhoneVerified ? T("Phone verified") : T("Phone pending"))</span>
                    <span class="tag @(string.IsNullOrEmpty(Model.DocumentFileName) ? "" : "tag-ok")">@Icon.Get("id-card", 12) @(string.IsNullOrEmpty(Model.DocumentFileName) ? T("ID pending") : T("ID submitted"))</span>
                </div>
                <p class="preview-bio @(hasBio ? "" : "is-empty")" id="previewBio">@(hasBio ? Model.Bio : T("Your bio will appear here."))</p>
                <div class="preview-langs" id="previewLangChips">
                    @if (!chosenLanguages.Any())
                    {
                        <span class="empty">@T("No languages selected")</span>
                    }
                    @foreach (var language in chosenLanguages)
                    {
                        <span class="tag">@T(language)</span>
                    }
                </div>
            </aside>
        </div>
    </div>
</div>
