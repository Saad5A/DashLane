@{
    ViewData["Title"] = "Create account - DashLane";
    Layout = "_AuthLayout";
    ViewData["MainClass"] = "flow-main";
    var authNotice = ViewData["AuthNotice"] as string;
    var fullNameValue = ViewData["FullName"] as string ?? "";
    var emailValue = ViewData["Email"] as string ?? "";
    var memberCount = (int?)ViewData["MemberCount"] ?? 0;
    var googleEnabled = ViewData["GoogleEnabled"] as bool? == true;
}

<div class="flow-page">
<p id="flow-status" class="flow-status" role="status" aria-live="polite" hidden></p>
<div class="flex flex-col w-full">
<div class="w-full max-w-[1140px] mx-auto py-space-md lg:py-space-xl">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-start">
<!-- Left Column: Trust Storytelling & Visual Benefits -->
<div class="lg:col-span-5 flex flex-col gap-space-lg order-2 lg:order-1">
<!-- Environmental Impact & Community Metric Card -->
<div class="bg-surface-container-lowest rounded-lg p-space-lg shadow-md flex flex-col gap-space-md relative overflow-hidden">
<div class="absolute -right-8 -top-8 w-32 h-32 rounded-full bg-secondary-fixed/20 blur-2xl pointer-events-none"></div>
<div class="flex items-center justify-between">
<span class="inline-flex items-center gap-space-2xs bg-secondary-fixed/30 px-space-xs py-1 rounded-full text-secondary font-label-badge text-label-badge">
<span class="material-symbols-outlined text-[15px]" style="font-variation-settings: 'FILL' 1;">eco</span>
<span>Collective Transit Impact</span>
</span>
<span class="font-caption text-caption text-outline">From the database</span>
</div>
<div class="flex flex-col gap-space-2xs">
<div class="flex items-baseline gap-space-xs">
<span class="font-headline-lg text-headline-lg font-bold text-on-surface tracking-tight tabular-nums">@memberCount</span>
<span class="font-label-numeric text-label-numeric text-secondary font-semibold">@(memberCount == 1 ? "member" : "members")</span>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant">Trip counts and emissions will be calculated from rides that members actually publish.</p>
</div>
<!-- Mini Inline Sparkline / Flow Visualization -->
<div class="w-full h-16 bg-surface-container-low rounded p-space-xs flex items-center justify-between gap-space-xs">
<div class="flex flex-col">
<span class="font-caption text-caption text-outline">Published routes</span>
<span class="font-label-numeric text-label-numeric text-on-surface font-semibold">None yet</span>
</div>
<svg class="w-32 h-10 text-primary-container" fill="none" viewbox="0 0 128 40" xmlns="http://www.w3.org/2000/svg">
<path d="M2 30C18 30 24 12 40 18C56 24 64 6 80 14C96 22 108 4 126 8" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path>
<circle cx="126" cy="8" fill="currentColor" r="3.5"></circle>
</svg>
</div>
</div>
<!-- Why Members Choose DashLane -->
<div class="bg-surface-container-low/70 rounded-lg p-space-lg flex flex-col gap-space-md">
<div class="flex items-center gap-space-xs">
<span class="material-symbols-outlined text-primary text-[22px]">workspace_premium</span>
<h3 class="font-headline-sm text-headline-sm font-bold text-on-surface">Why members choose DashLane</h3>
</div>
<div class="flex flex-col gap-space-sm">
<!-- Benefit Item 1 -->
<div class="flex items-start gap-space-sm p-space-sm rounded bg-surface-container-lowest/80 transition-all hover:bg-surface-container-lowest">
<div class="w-10 h-10 rounded-full bg-secondary-fixed/40 flex items-center justify-center shrink-0 text-secondary">
<span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">verified</span>
</div>
<div class="flex flex-col">
<span class="font-body-md text-body-md font-semibold text-on-surface">Verified Drivers &amp; Passengers</span>
<span class="font-body-sm text-body-sm text-on-surface-variant">Government ID checks, phone validation, and verified peer reviews ensure total trip confidence.</span>
</div>
</div>
<!-- Benefit Item 2 -->
<div class="flex items-start gap-space-sm p-space-sm rounded bg-surface-container-lowest/80 transition-all hover:bg-surface-container-lowest">
<div class="w-10 h-10 rounded-full bg-secondary-fixed/40 flex items-center justify-center shrink-0 text-secondary">
<span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">payments</span>
</div>
<div class="flex flex-col">
<span class="font-body-md text-body-md font-semibold text-on-surface">Automated Fuel Cost Split</span>
<span class="font-body-sm text-body-sm text-on-surface-variant">Zero awkward cash exchanges. Fares, tolls, and parking shares recalculate transparently upon booking.</span>
</div>
</div>
<!-- Benefit Item 3 -->
<div class="flex items-start gap-space-sm p-space-sm rounded bg-surface-container-lowest/80 transition-all hover:bg-surface-container-lowest">
<div class="w-10 h-10 rounded-full bg-secondary-fixed/40 flex items-center justify-center shrink-0 text-secondary">
<span class="material-symbols-outlined text-[20px]" style="font-variation-settings: 'FILL' 1;">nest_eco_leaf</span>
</div>
<div class="flex flex-col">
<span class="font-body-md text-body-md font-semibold text-on-surface">Carbon-Conscious Mobility</span>
<span class="font-body-sm text-body-sm text-on-surface-variant">Track your individualized footprint offset dashboard across interstate express routes.</span>
</div>
</div>
</div>
</div>
<!-- Social Proof Testimonial Pill -->
<div class="bg-surface-container-lowest rounded-lg p-space-md shadow-sm flex items-center gap-space-md">
<div class="w-12 h-12 rounded-full bg-surface-container flex items-center justify-center shrink-0 text-primary">
<span class="material-symbols-outlined text-[22px]">reviews</span>
</div>
<div class="flex flex-col min-w-0">
<p class="font-body-sm text-body-sm text-on-surface">Member reviews will appear after completed trips.</p>
<span class="font-caption text-caption text-outline">No reviews saved yet</span>
</div>
</div>
</div>
<!-- Right Column: Registration Card -->
<div class="lg:col-span-7 order-1 lg:order-2">
<div class="bg-surface-container-lowest rounded-lg p-space-lg sm:p-space-xl shadow-xl flex flex-col gap-space-lg">
<!-- Heading Section -->
<div class="flex flex-col gap-space-2xs">
<div class="flex items-center gap-space-xs text-primary mb-1">
<span class="material-symbols-outlined text-[20px]">person_add</span>
<span class="font-label-badge text-label-badge uppercase tracking-wider font-bold">New Account</span>
</div>
<h1 class="font-headline-lg text-headline-lg font-bold text-on-surface tracking-tight">Join DashLane</h1>
<p class="font-body-md text-body-md text-on-surface-variant">Create an account to start sharing rides and splitting travel costs across North America.</p>
</div>
<!-- OAuth Social Button -->
@if (googleEnabled)
{
    <form id="google-signup-form" method="post" action="@Url.Action("GoogleStart", "Home")">
        @Html.AntiForgeryToken()
        <input type="hidden" name="source" value="signup" />
        <input type="hidden" name="terms" id="google-terms" value="" />
        <button class="w-full h-12 rounded-full bg-surface-container-low hover:bg-surface-container transition-all flex items-center justify-center gap-space-sm px-space-md group" id="google-sign-up" type="submit">
            <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"></path>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"></path>
            </svg>
            <span class="font-body-md text-body-md font-semibold text-on-surface group-hover:text-primary transition-colors">Sign up with Google</span>
        </button>
    </form>
}
else
{
    <button class="w-full h-12 rounded-full bg-surface-container-low hover:bg-surface-container transition-all flex items-center justify-center gap-space-sm px-space-md group" id="google-sign-up" type="button" data-google-unavailable="true">
        <svg class="w-5 h-5 shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"></path>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"></path>
        </svg>
        <span class="font-body-md text-body-md font-semibold text-on-surface group-hover:text-primary transition-colors">Sign up with Google</span>
    </button>
}
<!-- Divider -->
<div class="relative flex items-center justify-center">
<div class="w-full h-[1px] bg-surface-container-high"></div>
<span class="absolute bg-surface-container-lowest px-space-sm font-caption text-caption text-outline uppercase tracking-wider">or use your email</span>
</div>
<!-- Main Input Form -->
<form class="flex flex-col gap-space-md" id="signup-form" method="post" action="@Url.Action("SignUp", "Home")" novalidate autocomplete="off" data-next="@Url.Action("Community", "Home")">
@Html.AntiForgeryToken()
<!-- Full Name -->
<div class="flex flex-col gap-space-2xs">
<label class="font-body-sm text-body-sm font-semibold text-on-surface" for="full-name">Full name</label>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-space-sm text-outline pointer-events-none text-[20px]">badge</span>
<input class="w-full h-12 pl-11 pr-space-md rounded bg-surface-container-low text-on-surface placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest transition-all font-body-md text-body-md shadow-sm" id="full-name" name="fullName" placeholder="Your name" required="" type="text" value="@fullNameValue" autocomplete="name"/>
</div>
</div>
<!-- Email Address -->
<div class="flex flex-col gap-space-2xs">
<label class="font-body-sm text-body-sm font-semibold text-on-surface" for="email-address">Email address</label>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-space-sm text-outline pointer-events-none text-[20px]">mail</span>
<input class="w-full h-12 pl-11 pr-space-md rounded bg-surface-container-low text-on-surface placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest transition-all font-body-md text-body-md shadow-sm" id="email-address" name="email" placeholder="name@@example.com" required="" type="email" value="@emailValue" autocomplete="email"/>
</div>
</div>
<!-- Create Password -->
<div class="flex flex-col gap-space-2xs">
<div class="flex items-center justify-between">
<label class="font-body-sm text-body-sm font-semibold text-on-surface" for="password">Create password</label>
<span class="font-caption text-caption text-outline">End-to-end encrypted</span>
</div>
<div class="relative flex items-center">
<span class="material-symbols-outlined absolute left-space-sm text-outline pointer-events-none text-[20px]">key</span>
<input class="w-full h-12 pl-11 pr-12 rounded bg-surface-container-low text-on-surface placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest transition-all font-body-md text-body-md shadow-sm" id="password" name="password" autocomplete="new-password" required="" type="password"/>
<button aria-label="Show password" aria-pressed="false" class="absolute right-space-sm text-outline hover:text-on-surface transition-colors p-1 flex items-center justify-center" id="toggle-password" type="button">
<span class="material-symbols-outlined text-[20px]" id="eye-icon">visibility</span>
</button>
</div>
<!-- Dynamic Requirement Checklist Pills -->
<div class="flex flex-wrap items-center gap-space-xs mt-1">
<!-- Requirement 1: 8 chars -->
<div class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-surface-container font-caption text-caption text-on-surface-variant transition-colors" id="req-length">
<span class="material-symbols-outlined text-[14px]" id="req-length-icon">radio_button_unchecked</span>
<span>At least 8 characters</span>
</div>
<!-- Requirement 2: One number -->
<div class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-surface-container font-caption text-caption text-on-surface-variant transition-colors" id="req-number">
<span class="material-symbols-outlined text-[14px]" id="req-number-icon">radio_button_unchecked</span>
<span>One number</span>
</div>
<!-- Requirement 3: Special character -->
<div class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-surface-container font-caption text-caption text-on-surface-variant transition-colors" id="req-special">
<span class="material-symbols-outlined text-[14px]" id="req-special-icon">radio_button_unchecked</span>
<span>One special character</span>
</div>
</div>
</div>
<!-- Terms & Privacy Checkbox -->
<div class="flex items-start gap-space-sm pt-space-xs">
<div class="flex items-center h-5">
<input class="w-4 h-4 rounded text-primary-container focus:ring-0 cursor-pointer accent-primary-container" id="terms" name="terms" value="true" required="" type="checkbox"/>
</div>
<label class="font-body-sm text-body-sm text-on-surface-variant leading-tight cursor-pointer" for="terms">
                I agree to the <a class="text-primary-container font-semibold hover:underline" href="@Url.Action("Terms", "Home")" target="_blank" rel="noopener" onclick="event.stopPropagation()">Terms of Service</a> and acknowledge the <a class="text-primary-container font-semibold hover:underline" href="@Url.Action("Privacy", "Home")" target="_blank" rel="noopener" onclick="event.stopPropagation()">Privacy Policy</a>.
              </label>
</div>
<p id="signup-status" class="font-body-sm text-body-sm text-error" role="status" aria-live="polite" @(string.IsNullOrEmpty(authNotice) ? "hidden" : null)>@authNotice</p>
<!-- Primary Action Button -->
<button class="w-full h-12 rounded-full bg-primary-container text-on-primary font-body-md text-body-md font-semibold tracking-wide hover:bg-secondary transition-all shadow-md active:scale-[0.99] flex items-center justify-center gap-space-xs mt-space-2xs cursor-pointer" type="submit">
<span>Create account</span>
<span class="material-symbols-outlined text-[18px]">arrow_forward</span>
</button>
</form>
<!-- Footer Switch Link -->
<div class="flex items-center justify-center gap-space-2xs font-body-sm text-body-sm pt-space-2xs">
<span class="text-on-surface-variant">Already have an account?</span>
<a class="text-primary-container font-semibold hover:underline inline-flex items-center gap-0.5" href="@Url.Action("SignIn", "Home")">
<span>Log in</span>
<span class="material-symbols-outlined text-[15px]">chevron_right</span>
</a>
</div>
</div>
</div>
</div>
</div>
<!-- Interactive Logic for Password Toggle & Requirement Checking -->

</div></div>
