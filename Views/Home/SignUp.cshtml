@{
    ViewData["Title"] = T("Create your account") + " — DashLane";
    ViewData["AuthPage"] = "signup";
    Layout = "_AuthLayout";
    var authNotice = ViewData["AuthNotice"] as string;
    var fullNameValue = ViewData["FullName"] as string ?? "";
    var emailValue = ViewData["Email"] as string ?? "";
    var memberCount = (int?)ViewData["MemberCount"] ?? 0;
    var googleEnabled = ViewData["GoogleEnabled"] as bool? == true;
}

<div class="auth">
    <div class="auth-split">
        <div>
            <div class="auth-head rise">
                @Icon.Logo(44)
                <h1 class="auth-title">@T("Create your account")</h1>
                <p class="auth-sub">@T("Share the drive between Canadian cities. Free to join.")</p>
            </div>

            <div class="auth-stack rise rise-1">
                @if (googleEnabled)
                {
                    <form id="google-signup-form" method="post" action="@Url.Action("GoogleStart", "Home")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="source" value="signup" />
                        <input type="hidden" name="terms" id="google-terms" value="" />
                        <button class="btn btn-secondary btn-lg btn-block" id="google-sign-up" type="submit">
                            @Icon.Google()
                            <span>@T("Sign up with Google")</span>
                        </button>
                    </form>
                }
                else
                {
                    <button class="btn btn-secondary btn-lg btn-block" id="google-sign-up" type="button" data-google-unavailable="true" data-status-target="signup-status">
                        @Icon.Google()
                        <span>@T("Sign up with Google")</span>
                    </button>
                }

                <div class="divider">or</div>

                <form class="auth-form" id="signup-form" method="post" action="@Url.Action("SignUp", "Home")" novalidate>
                    @Html.AntiForgeryToken()

                    <p id="signup-status" class="notice notice-err" role="status" aria-live="polite" @(string.IsNullOrEmpty(authNotice) ? "hidden" : null)>@authNotice</p>

                    <div class="field">
                        <label class="label" for="full-name">@T("Full name")</label>
                        <div class="control">
                            @Icon.Get("user", 16)
                            <input class="input" id="full-name" name="fullName" placeholder="Alex Tremblay" required type="text" value="@fullNameValue" autocomplete="name" />
                        </div>
                    </div>

                    <div class="field">
                        <label class="label" for="email-address">@T("Email")</label>
                        <div class="control">
                            @Icon.Get("mail", 16)
                            <input class="input" id="email-address" name="email" placeholder="you@@example.com" required type="email" value="@emailValue" autocomplete="email" autocapitalize="none" spellcheck="false" />
                        </div>
                    </div>

                    <div class="field">
                        <label class="label" for="password">@T("Password")</label>
                        <div class="control">
                            @Icon.Get("key", 16)
                            <input class="input" id="password" name="password" autocomplete="new-password" required type="password" aria-describedby="password-rules" />
                            <span class="control-trail">
                                <button type="button" class="icon-btn reveal" data-reveal="password" aria-label="@T("Show password")" aria-pressed="false" aria-controls="password">
                                    @Icon.Get("eye", 16, "i-show")
                                    @Icon.Get("eye-off", 16, "i-hide")
                                </button>
                            </span>
                        </div>
                        <div class="rules" id="password-rules">
                            <span class="rule" data-rule="length">@T("8+ characters")</span>
                            <span class="rule" data-rule="number">@T("A number")</span>
                            <span class="rule" data-rule="special">@T("A symbol")</span>
                        </div>
                    </div>

                    <label class="check" for="terms">
                        <input id="terms" name="terms" value="true" required type="checkbox" />
                        <span>@T("I agree to the") <a class="link" href="@Url.Action("Terms", "Home")" target="_blank" rel="noopener">@T("Terms of Service")</a> @T("and acknowledge the") <a class="link" href="@Url.Action("Privacy", "Home")" target="_blank" rel="noopener">@T("Privacy Policy")</a>.</span>
                    </label>

                    <button class="btn btn-accent btn-lg btn-block" type="submit" data-busy>
                        <span>@T("Create account")</span>
                        @Icon.Get("arrow-right", 16, "i-nudge")
                    </button>
                </form>
            </div>

            <p class="auth-foot rise rise-2">@T("Already a member?") <a class="link" href="@Url.Action("SignIn", "Home")">@T("Log in")</a></p>
        </div>

        <aside class="journey rise rise-3" aria-label="@T("What happens after you sign up")">
            <div class="journey-head">
                <p class="journey-title">@T("After you sign up")</p>
                <span class="eyebrow">@T("5 steps")</span>
            </div>
            <ol class="timeline">
                <li class="tl-item is-now">
                    <span class="tl-node">00</span>
                    <div class="tl-text"><p class="tl-title">@T("Create your account")</p><p class="tl-sub">@T("Email and password, or Google.")</p></div>
                </li>
                <li class="tl-item">
                    <span class="tl-node">01</span>
                    <div class="tl-text"><p class="tl-title">@T("About you")</p><p class="tl-sub">@T("Legal name and date of birth (18+).")</p></div>
                </li>
                <li class="tl-item">
                    <span class="tl-node">02</span>
                    <div class="tl-text"><p class="tl-title">@T("Profile")</p><p class="tl-sub">@T("Photo, bio, languages, ride preferences.")</p></div>
                </li>
                <li class="tl-item">
                    <span class="tl-node">03</span>
                    <div class="tl-text"><p class="tl-title">@T("Phone")</p><p class="tl-sub">@T("6-digit SMS code to a Canadian number.")</p></div>
                </li>
                <li class="tl-item">
                    <span class="tl-node">04</span>
                    <div class="tl-text"><p class="tl-title">@T("Identity")</p><p class="tl-sub">@T("Licence, passport or provincial ID.")</p></div>
                </li>
            </ol>
            <div class="journey-foot">
                <span class="status-line"><span class="dot dot-live"></span>@(memberCount == 0 ? T("No members yet — you'd be first") : T(memberCount == 1 ? "{0} member so far" : "{0} members so far", memberCount.ToString("N0")))</span>
                <span class="status-line">@Icon.Get("lock", 13) @T("Never shown publicly")</span>
            </div>
        </aside>
    </div>
</div>
