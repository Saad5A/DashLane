@{
    ViewData["Title"] = T("Welcome") + " — DashLane";
    Layout = "_AuthLayout";
    var name = (User.Identity?.Name ?? "").Trim();
    var first = string.IsNullOrEmpty(name) ? "" : name.Split(' ', StringSplitOptions.RemoveEmptyEntries)[0];
}

<div class="welcome">
    <p class="eyebrow eyebrow-accent rise">@(string.IsNullOrEmpty(first) ? T("Welcome to DashLane") : T("Welcome, {0}", first))</p>
    <h1 class="display rise rise-1">@T("Good trips start with good company.")</h1>
    <p class="lede rise rise-2">@T("DashLane connects people travelling in the same direction so they can share the drive. A few ground rules first — then five quick setup steps.")</p>

    <div class="journey-road rise rise-3" role="img" aria-label="@T("Five setup steps. Each one unlocks the next.")">
        <div class="jr-track" aria-hidden="true"><span class="jr-lane"></span><span class="jr-car">@Icon.Get("car", 18)</span></div>
        <ol class="jr-stops" aria-hidden="true">
            <li class="is-next"><span class="jr-pin">01</span><span class="jr-label">@T("About you")</span><span class="jr-note">@T("Start here")</span></li>
            <li><span class="jr-pin">@Icon.Get("lock", 12)</span><span class="jr-label">@T("Profile")</span></li>
            <li><span class="jr-pin">@Icon.Get("lock", 12)</span><span class="jr-label">@T("Phone")</span></li>
            <li><span class="jr-pin">@Icon.Get("lock", 12)</span><span class="jr-label">@T("Identity")</span></li>
            <li><span class="jr-pin">@Icon.Get("lock", 12)</span><span class="jr-label">@T("Review")</span></li>
        </ol>
        <p class="jr-caption">@Icon.Get("lock", 13) @T("Each step unlocks the next — you can't skip ahead.")</p>
    </div>

    <div class="principles rise rise-4">
        <section class="principle">
            <span class="num">01</span>
            <h2>@T("Be who you say you are")</h2>
            <p>@T("Real name, a recognizable photo, and a verified phone and ID before anyone books.")</p>
        </section>
        <section class="principle">
            <span class="num">02</span>
            <h2>@T("Show up on time")</h2>
            <p>@T("Pickups are scheduled. If plans change, tell your co-riders as early as you can.")</p>
        </section>
        <section class="principle">
            <span class="num">03</span>
            <h2>@T("Respect the ride")</h2>
            <p>@T("Honour the preferences everyone set — quiet, music, pets, no smoking. Zero tolerance for harassment.")</p>
        </section>
    </div>

    <div class="card checklist rise rise-5">
        <div>
            <p class="fs-title">@T("What we'll ask for")</p>
            <ul class="checklist-items">
                <li>@Icon.Get("user", 15) @T("Name & birthday")</li>
                <li>@Icon.Get("camera", 15) @T("Photo & bio")</li>
                <li>@Icon.Get("phone", 15) @T("Mobile number")</li>
                <li>@Icon.Get("id-card", 15) @T("Government ID")</li>
            </ul>
        </div>
        <a class="btn btn-accent btn-lg" id="btn-complete-profile" href="@Url.Action("AboutYou", "Home")">
            <span>@T("Start setup")</span>
            @Icon.Get("arrow-right", 16, "i-nudge")
        </a>
    </div>

    <p class="welcome-foot rise rise-5">
        <a class="link-quiet" href="@Url.Action("CommunityStandards", "Home")">@T("Read the full community standards →")</a>
    </p>
</div>
