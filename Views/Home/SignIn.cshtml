@{
    ViewData["Title"] = T("Log in") + " — DashLane";
    ViewData["AuthPage"] = "signin";
    Layout = "_AuthLayout";
    var authNotice = ViewData["AuthNotice"] as string;
    var emailValue = ViewData["Email"] as string ?? "";
    var googleEnabled = ViewData["GoogleEnabled"] as bool? == true;
}

<div class="auth">
    <div class="auth-box">
        <div class="auth-head rise">
            @Icon.Logo(44)
            <h1 class="auth-title">@T("Log in to DashLane")</h1>
            <p class="auth-sub">@T("Welcome back. Pick up where you left off.")</p>
        </div>

        <div class="auth-stack rise rise-1">
            @if (googleEnabled)
            {
                <form method="post" action="@Url.Action("GoogleStart", "Home")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="source" value="signin" />
                    <button type="submit" class="btn btn-secondary btn-lg btn-block" id="google-sign-in">
                        @Icon.Google()
                        <span>@T("Continue with Google")</span>
                    </button>
                </form>
            }
            else
            {
                <button type="button" class="btn btn-secondary btn-lg btn-block" id="google-sign-in" data-google-unavailable="true" data-status-target="sign-in-status" aria-controls="sign-in-status">
                    @Icon.Google()
                    <span>@T("Continue with Google")</span>
                </button>
            }

            <div class="divider">or</div>

            <form id="sign-in-form" class="auth-form" method="post" action="@Url.Action("SignIn", "Home")" novalidate>
                @Html.AntiForgeryToken()

                <p id="sign-in-status" class="notice notice-err" role="status" aria-live="polite" @(string.IsNullOrEmpty(authNotice) ? "hidden" : null)>@authNotice</p>

                <div class="field">
                    <label class="label" for="login-email">@T("Email")</label>
                    <div class="control">
                        @Icon.Get("mail", 16)
                        <input class="input" id="login-email" name="email" type="email" inputmode="email" autocomplete="username" autocapitalize="none" spellcheck="false" placeholder="you@@example.com" value="@emailValue" aria-describedby="login-email-hint" aria-invalid="false" required autofocus />
                    </div>
                    <p id="login-email-hint" class="hint-error" aria-live="polite" hidden>@Icon.Get("alert", 13)<span class="hint-text"></span></p>
                </div>

                <div class="field">
                    <div class="label-row">
                        <label class="label" for="login-password">@T("Password")</label>
                        <button type="button" class="link-quiet" data-unavailable-message="@T("Password reset isn't available yet.")" data-status-target="sign-in-status" aria-controls="sign-in-status">@T("Forgot?")</button>
                    </div>
                    <div class="control">
                        @Icon.Get("lock", 16)
                        <input class="input" id="login-password" name="password" type="password" autocomplete="current-password" spellcheck="false" aria-describedby="login-password-hint" aria-invalid="false" required />
                        <span class="control-trail">
                            <button type="button" class="icon-btn reveal" data-reveal="login-password" aria-label="@T("Show password")" aria-pressed="false" aria-controls="login-password">
                                @Icon.Get("eye", 16, "i-show")
                                @Icon.Get("eye-off", 16, "i-hide")
                            </button>
                        </span>
                    </div>
                    <p id="login-password-hint" class="hint-error" aria-live="polite" hidden>@Icon.Get("alert", 13)<span class="hint-text"></span></p>
                </div>

                <label class="check">
                    <input type="checkbox" name="remember" value="true" checked />
                    <span>@T("Keep me signed in on this device")</span>
                </label>

                <button class="btn btn-primary btn-lg btn-block" type="submit" data-busy>
                    <span>@T("Log in")</span>
                    @Icon.Get("arrow-right", 16, "i-nudge")
                </button>
            </form>
        </div>

        <p class="auth-foot rise rise-2">@T("New to DashLane?") <a class="link" href="@Url.Action("SignUp", "Home")">@T("Create an account")</a></p>
    </div>
</div>
