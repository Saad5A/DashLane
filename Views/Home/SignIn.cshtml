@{
    ViewData["Title"] = "Log in - DashLane";
    Layout = "_AuthLayout";
    var authNotice = ViewData["AuthNotice"] as string;
    var emailValue = ViewData["Email"] as string ?? "";
}

<div class="signin-page">
    <div class="signin-grid">
        <section class="signin-card" aria-labelledby="signin-title">
            <div class="card-accent" aria-hidden="true"></div>
            <div class="card-brand">
                <div class="brand">
                    <span class="material-symbols-outlined brand-mark icon-28" aria-hidden="true">alt_route</span>
                    <span class="brand-name">DashLane</span>
                </div>
                <div class="secure-chip">
                    <span class="material-symbols-outlined icon-15" aria-hidden="true">verified_user</span>
                    <span>Secure sign in</span>
                </div>
            </div>

            <div class="signin-heading">
                <h1 id="signin-title">Welcome back</h1>
                <p>Log in to manage your trips, messages, and bookings.</p>
            </div>

            <button type="button" class="btn-google" id="google-sign-in" aria-controls="sign-in-status">
                <svg class="google-mark" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path>
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path>
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"></path>
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"></path>
                </svg>
                <span>Continue with Google</span>
            </button>

            <div class="divider">
                <span>or use your email</span>
            </div>

            <form id="sign-in-form" class="signin-form" method="post" action="@Url.Action("SignIn", "Home")" novalidate autocomplete="off">
                @Html.AntiForgeryToken()
                <div class="field">
                    <label for="login-email">Email address</label>
                    <div class="input-shell">
                        <span class="material-symbols-outlined input-icon icon-20" aria-hidden="true">mail</span>
                        <input class="text-input" id="login-email" name="email" type="email" inputmode="email" autocomplete="username" autocapitalize="none" spellcheck="false" placeholder="name@@example.com" value="@emailValue" aria-describedby="login-email-hint" aria-invalid="false" required />
                    </div>
                    <p id="login-email-hint" class="field-hint hint-error" aria-live="polite" hidden>
                        <span class="material-symbols-outlined icon-14 hint-icon" aria-hidden="true">error</span>
                        <span class="hint-text"></span>
                    </p>
                </div>

                <div class="field">
                    <div class="label-row">
                        <label for="login-password">Password</label>
                        <button type="button" class="text-link" data-unavailable-message="Password reset is not available yet." data-status-target="sign-in-status" aria-controls="sign-in-status">Forgot password?</button>
                    </div>
                    <div class="input-shell">
                        <span class="material-symbols-outlined input-icon icon-20" aria-hidden="true">lock</span>
                        <input class="text-input password-input" id="login-password" name="password" type="password" autocomplete="current-password" spellcheck="false" placeholder="Enter your password" aria-describedby="login-password-hint" aria-invalid="false" required />
                        <button type="button" class="visibility-btn" id="toggle-password-btn" aria-label="Show password" aria-pressed="false" aria-controls="login-password">
                            <span class="material-symbols-outlined icon-20" id="password-visibility-icon">visibility</span>
                        </button>
                    </div>
                    <p id="login-password-hint" class="field-hint hint-error" aria-live="polite" hidden>
                        <span class="material-symbols-outlined icon-14 hint-icon" aria-hidden="true">error</span>
                        <span class="hint-text"></span>
                    </p>
                </div>

                <div class="form-meta">
                    <label class="remember">
                        <input type="checkbox" name="remember" value="true" checked />
                        <span>Remember this device</span>
                    </label>
                    <span class="tls-note">
                        <span class="material-symbols-outlined icon-13" aria-hidden="true">encrypted</span>
                        <span>Local account</span>
                    </span>
                </div>

                <button class="btn btn-submit" type="submit">
                    <span>Log in</span>
                    <span class="material-symbols-outlined icon-18" aria-hidden="true">arrow_forward</span>
                </button>
                <p id="sign-in-status" class="status-note" role="status" aria-live="polite" @(string.IsNullOrEmpty(authNotice) ? "hidden" : null)>@authNotice</p>
            </form>

            <div class="card-footer">
                <span>New to DashLane?</span>
                <a class="text-link" href="@Url.Action("SignUp", "Home")">Create an account</a>
            </div>
        </section>

        <aside class="signin-aside" aria-label="Why DashLane">
            <div class="assurance-card">
                <svg class="assurance-art" viewBox="0 0 200 200" fill="none" aria-hidden="true">
                    <circle cx="100" cy="100" r="80" stroke="currentColor" stroke-dasharray="8 12" stroke-width="8"></circle>
                    <path d="M20 100C40 60 80 40 120 70C160 100 180 160 180 160" stroke="currentColor" stroke-linecap="round" stroke-width="4"></path>
                    <circle cx="120" cy="70" r="7" fill="currentColor"></circle>
                </svg>
                <div class="assurance-body">
                    <div class="network-chip">
                        <span class="pulse-dot" aria-hidden="true"></span>
                        <span>Shared Transit Network</span>
                    </div>
                    <div>
                        <h2>Grounded, verified peer-to-peer travel.</h2>
                        <p class="assurance-lead">Connecting drivers with co-travelers so they can share a ride and split travel costs.</p>
                    </div>
                    <div class="feature feature-offset">
                        <div class="feature-icon">
                            <span class="material-symbols-outlined icon-20" aria-hidden="true">badge</span>
                        </div>
                        <div>
                            <h3>Identity checks before booking</h3>
                            <p>Members confirm a phone number and upload a government document during setup.</p>
                        </div>
                    </div>
                    <div class="feature">
                        <div class="feature-icon">
                            <span class="material-symbols-outlined icon-20" aria-hidden="true">toll</span>
                        </div>
                        <div>
                            <h3>Zero hidden booking surcharges</h3>
                            <p>Split fuel and toll expenses mathematically. Direct per-seat breakdown before reservation.</p>
                        </div>
                    </div>
                    <div class="feature">
                        <div class="feature-icon">
                            <span class="material-symbols-outlined icon-20" aria-hidden="true">health_and_safety</span>
                        </div>
                        <div>
                            <h3>Identity checks before a trip</h3>
                            <p>Members confirm a phone number and upload a government document before booking is available.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="trip-card">
                <div class="trip-person">
                    <div class="avatar avatar-md" aria-hidden="true">
                        <span class="material-symbols-outlined icon-18">route</span>
                    </div>
                    <div>
                        <div class="trip-name">
                            <span>No completed trips yet</span>
                        </div>
                        <span class="trip-route">Rides will show here after members post them.</span>
                    </div>
                </div>
            </div>
        </aside>
    </div>
</div>
