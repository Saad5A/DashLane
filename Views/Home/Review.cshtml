@model Member
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = T("Review and confirm") + " — DashLane";
    ViewData["Step"] = 5;
    Layout = "_AuthLayout";
    var notice = ViewData["Notice"] as string;
    var noticeOk = ViewData["NoticeKind"] as string == "ok";
    var done = Model.CompletedSteps;
    var percent = done * 25;
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    var circumference = 2 * Math.PI * 36;
    var offset = circumference * (1 - percent / 100.0);
    var finished = Model.OnboardingCompletedUtc.HasValue && done == 4;
    var aboutDone = Model.DateOfBirth.HasValue && !string.IsNullOrWhiteSpace(Model.LegalName);
    var profileDone = Model.ProfileCompletedUtc.HasValue;
    var idDone = !string.IsNullOrWhiteSpace(Model.DocumentFileName);
    var languageNames = new Dictionary<string, string> { ["en-CA"] = "English (Canada)", ["fr-CA"] = "Français (Canada)", ["es"] = "Español", ["en-US"] = "English (US)" };
    var notProvided = T("Not provided");
    string Or(string? value, string? fallback = null) => string.IsNullOrWhiteSpace(value) ? (fallback ?? notProvided) : value;
    string Missing(string? value) => string.IsNullOrWhiteSpace(value) ? "is-missing" : "";
    var (checkClass, checkLabel) = Model.DocumentCheckDecision switch
    {
        "accept" => ("tag-ok", T("Passed automatic check")),
        "review" => ("tag-accent", T("Needs manual review")),
        "reject" => ("tag-err", T("Didn't pass")),
        _ => ("", T("Not checked automatically"))
    };
    IHtmlContent Num(bool isDone, string n) => isDone ? Icon.Get("check", 12) : new HtmlString(n);
}

<div class="setup">
    <partial name="_SetupSteps" model="Model" />

    <div class="sheet">
        <header class="sheet-head rise">
            <p class="eyebrow">@T("Step") 05 / 05</p>
            <h1 class="sheet-title">@(finished ? T("You're all set") : T("Review and confirm"))</h1>
            <p class="sheet-lede">@(finished ? T("Your profile is saved. We'll let you know as soon as the ride feed opens.") : T("Check everything once. You can edit any section before you confirm."))</p>
        </header>

        <p id="flow-status" class="notice notice-err" role="status" aria-live="polite" hidden="@(TempData["GateNotice"] is not string)">@TempData["GateNotice"]</p>

        @if (finished && notice == null)
        {
            <div class="done-banner rise rise-1">
                <span class="tick">@Icon.Get("check", 16)</span>
                <span>@T("Setup completed on") <span class="mono">@Model.OnboardingCompletedUtc!.Value.ToLocalTime().ToString("yyyy-MM-dd")</span></span>
            </div>
        }

        <div class="card form-card rise rise-1">
            @if (!string.IsNullOrEmpty(notice))
            {
                <div class="form-notice"><p class="notice @(noticeOk ? "notice-ok" : "notice-err")" role="status">@notice</p></div>
            }

            <div class="review-hero">
                <div class="ring" role="img" aria-label="@percent%">
                    <svg viewBox="0 0 84 84" aria-hidden="true">
                        <defs>
                            <linearGradient id="ringGrad" x1="0" y1="0" x2="1" y2="1">
                                <stop offset="0" stop-color="#ffbd21" />
                                <stop offset="1" stop-color="#ea580c" />
                            </linearGradient>
                        </defs>
                        <circle class="track" cx="42" cy="42" r="36" />
                        <circle class="fill" cx="42" cy="42" r="36" stroke-dasharray="@circumference.ToString("0.##", inv)" stroke-dashoffset="@offset.ToString("0.##", inv)" />
                    </svg>
                    <span class="ring-label tabular">@percent%</span>
                </div>
                <div>
                    <p class="fs-title">@(done == 4 ? T("Every step is complete") : T("{0} of 4 steps left", 4 - done))</p>
                    <p class="fs-sub">@T("{0} of 4 verification steps done.", done)</p>
                </div>
            </div>

            <ol class="review-list">
                <li class="review-item @(aboutDone ? "is-done" : "")">
                    <span class="review-num">@Num(aboutDone, "01")</span>
                    <div>
                        <p class="review-title">@T("About you")</p>
                        <dl class="review-data">
                            <div><dt>@T("Legal name")</dt><dd class="@Missing(Model.LegalName)">@Or(Model.LegalName)</dd></div>
                            <div><dt>@T("Date of birth")</dt><dd class="@(Model.DateOfBirth == null ? "is-missing" : "mono")">@(Model.DateOfBirth?.ToString("yyyy-MM-dd") ?? notProvided)</dd></div>
                            <div><dt>@T("Home city")</dt><dd class="@Missing(Model.HomeCity)">@Or(Model.HomeCity)</dd></div>
                            <div><dt>@T("Gender")</dt><dd class="@Missing(Model.Gender)">@(string.IsNullOrWhiteSpace(Model.Gender) ? notProvided : T(Model.Gender))</dd></div>
                            <div><dt>@T("Language")</dt><dd class="@Missing(Model.PreferredLanguage)">@(Model.PreferredLanguage != null && languageNames.TryGetValue(Model.PreferredLanguage, out var ln) ? ln : Or(Model.PreferredLanguage))</dd></div>
                        </dl>
                    </div>
                    <a class="btn btn-ghost btn-sm" href="@Url.Action("AboutYou", "Home")">@Icon.Get("pencil", 13) @T("Edit")</a>
                </li>

                <li class="review-item @(profileDone ? "is-done" : "")">
                    <span class="review-num">@Num(profileDone, "02")</span>
                    <div>
                        <div class="preview-id">
                            <div class="avatar avatar-sm">
                                @Icon.Get("user", 18)
                                @if (!string.IsNullOrEmpty(Model.PhotoFileName))
                                {
                                    <img alt="" src="@Url.Action("Photo", "Home")" />
                                }
                            </div>
                            <p class="review-title">@T("Profile") <span class="review-aside">· @T("shown as") @Model.PublicName</span></p>
                        </div>
                        <p class="review-bio">@(string.IsNullOrWhiteSpace(Model.Bio) ? T("No bio yet.") : Model.Bio)</p>
                        @if (Model.LanguageList.Any() || Model.PreferenceList.Any())
                        {
                            <div class="preview-langs">
                                @foreach (var language in Model.LanguageList)
                                {
                                    <span class="tag">@T(language)</span>
                                }
                                @foreach (var preference in Model.PreferenceList)
                                {
                                    <span class="tag tag-accent">@T(preference)</span>
                                }
                            </div>
                        }
                    </div>
                    <a class="btn btn-ghost btn-sm" href="@Url.Action("Profile", "Home")">@Icon.Get("pencil", 13) @T("Edit")</a>
                </li>

                <li class="review-item @(Model.PhoneVerified ? "is-done" : "")">
                    <span class="review-num">@Num(Model.PhoneVerified, "03")</span>
                    <div>
                        <p class="review-title">@T("Contact") @if (Model.PhoneVerified) { <span class="tag tag-ok">@T("Verified")</span> } else { <span class="tag">@T("Not verified")</span> }</p>
                        <dl class="review-data">
                            <div><dt>@T("Mobile")</dt><dd class="@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "is-missing" : "mono")">@Or(Model.PhoneNumber)</dd></div>
                            <div><dt>@T("Email")</dt><dd>@Model.Email</dd></div>
                        </dl>
                    </div>
                    <a class="btn btn-ghost btn-sm" href="@Url.Action("Contact", "Home")">@Icon.Get("pencil", 13) @T("Edit")</a>
                </li>

                <li class="review-item @(idDone ? "is-done" : "")">
                    <span class="review-num">@Num(idDone, "04")</span>
                    <div>
                        <p class="review-title">@T("Identity") @if (idDone) { <span class="tag @checkClass">@checkLabel</span> } else { <span class="tag">@T("Not uploaded")</span> }</p>
                        <dl class="review-data">
                            <div><dt>@T("Document")</dt><dd class="@Missing(Model.DocumentType)">@(string.IsNullOrWhiteSpace(Model.DocumentType) ? T("Not selected") : T(Model.DocumentType))</dd></div>
                            <div><dt>@T("Issued in")</dt><dd>@T("Canada")</dd></div>
                        </dl>
                        @if (idDone && !string.IsNullOrWhiteSpace(Model.DocumentCheckSummary))
                        {
                            <p class="review-bio">@CheckSummary(Model.DocumentCheckSummary)</p>
                        }
                    </div>
                    <a class="btn btn-ghost btn-sm" href="@Url.Action("Identity", "Home")">@Icon.Get("pencil", 13) @T("Edit")</a>
                </li>
            </ol>

            <form class="form-actions" method="post" action="@Url.Action("ReviewConfirm", "Home")">
                @Html.AntiForgeryToken()
                <a class="btn btn-ghost" href="@Url.Action("Identity", "Home")">@Icon.Get("arrow-left", 16) @T("Back")</a>
                <span class="grow"></span>
                <span class="aside">@T("By confirming you accept the") <a class="link" href="@Url.Action("CommunityStandards", "Home")">@T("community standards")</a></span>
                <button class="btn @(done == 4 ? "btn-accent" : "btn-secondary")" type="submit" data-busy>
                    <span>@(finished ? T("Confirm again") : T("Confirm & finish"))</span>
                    @Icon.Get("check", 16)
                </button>
            </form>
        </div>
    </div>
</div>
