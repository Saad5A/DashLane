@model Member
@{
    ViewData["Title"] = T("About you") + " — DashLane";
    ViewData["Step"] = 1;
    Layout = "_AuthLayout";
    var notice = ViewData["Notice"] as string;
    var dob = Model.DateOfBirth;
    var months = System.Globalization.CultureInfo.CurrentUICulture.DateTimeFormat.MonthNames.Take(12).ToArray();
    var genders = new[] { "Woman", "Man", "Non-binary", "Other", "Prefer not to say" };
    var languages = new[]
    {
        ("en-CA", "English (Canada)"),
        ("fr-CA", "Français (Canada)"),
        ("es", "Español"),
        ("en-US", "English (US)")
    };
    var preferred = string.IsNullOrEmpty(Model.PreferredLanguage) ? "en-CA" : Model.PreferredLanguage;
}

<div class="setup">
    <partial name="_SetupSteps" model="Model" />

    <div class="sheet">
        <header class="sheet-head rise">
            <p class="eyebrow">@T("Step") 01 / 05</p>
            <h1 class="sheet-title">@T("Tell us about yourself")</h1>
            <p class="sheet-lede">@T("This is what we check your ID against later, and how we confirm you're 18 or older. None of it is shown on your public profile.")</p>
        </header>

        <p id="flow-status" class="notice notice-err" role="status" aria-live="polite" hidden="@(TempData["GateNotice"] is not string)">@TempData["GateNotice"]</p>

        <form class="card form-card rise rise-1" method="post" action="@Url.Action("AboutYou", "Home")" novalidate>
            @Html.AntiForgeryToken()

            @if (!string.IsNullOrEmpty(notice))
            {
                <div class="form-notice"><p class="notice notice-err" role="status">@notice</p></div>
            }

            <section class="form-section">
                <div>
                    <h2 class="fs-title">@T("Identity")</h2>
                    <p class="fs-sub">@T("Must match your government ID exactly.")</p>
                </div>
                <div class="fs-body">
                    <div class="field">
                        <label class="label" for="legalName">@T("Full legal name")</label>
                        <div class="control">
                            @Icon.Get("user", 16)
                            <input class="input" id="legalName" name="legalName" placeholder="@T("First and last name")" type="text" value="@Model.LegalName" autocomplete="name" required />
                        </div>
                    </div>

                    <fieldset class="field fieldset">
                        <div class="label-row">
                            <legend class="label">@T("Date of birth")</legend>
                            <span class="label-aside">@T("18+ only")</span>
                        </div>
                        <div class="row row-dob">
                            <input class="input mono" aria-label="@T("Day")" id="dobDay" name="dobDay" min="1" max="31" placeholder="DD" type="number" inputmode="numeric" value="@(dob?.Day)" autocomplete="bday-day" />
                            <div class="select-wrap">
                                <select class="select" aria-label="@T("Month")" id="dobMonth" name="dobMonth" autocomplete="bday-month">
                                    @if (dob == null)
                                    {
                                        <option value="" selected disabled>@T("Month")</option>
                                    }
                                    @for (var m = 0; m < 12; m++)
                                    {
                                        var number = m + 1;
                                        if (dob?.Month == number)
                                        {
                                            <option value="@number" selected>@months[m]</option>
                                        }
                                        else
                                        {
                                            <option value="@number">@months[m]</option>
                                        }
                                    }
                                </select>
                                @Icon.Get("chevron-down", 14)
                            </div>
                            <input class="input mono" aria-label="@T("Year")" id="dobYear" name="dobYear" min="1900" max="@(DateTime.Today.Year - 18)" placeholder="YYYY" type="number" inputmode="numeric" value="@(dob?.Year)" autocomplete="bday-year" />
                        </div>
                    </fieldset>
                </div>
            </section>

            <section class="form-section">
                <div>
                    <h2 class="fs-title">@T("Gender")</h2>
                    <p class="fs-sub">@T("Optional. Lets you join women-only rides when they launch.")</p>
                </div>
                <div class="fs-body">
                    <input type="hidden" name="gender" id="gender" value="@Model.Gender" />
                    <div class="chips" role="radiogroup" aria-label="@T("Gender identity")" data-radio-group="gender">
                        @foreach (var g in genders)
                        {
                            <button type="button" class="chip" role="radio" aria-checked="false" data-value="@g">@Icon.Get("check", 14, "chip-check")<span>@T(g)</span></button>
                        }
                    </div>
                </div>
            </section>

            <section class="form-section">
                <div>
                    <h2 class="fs-title">@T("Location & language")</h2>
                    <p class="fs-sub">@T("Helps us suggest nearby pickups.")</p>
                </div>
                <div class="fs-body">
                    <div class="row row-2">
                        <div class="field">
                            <label class="label" for="homeCity">@T("Home city")</label>
                            <div class="ac" id="city-autocomplete">
                                <div class="control">
                                    @Icon.Get("map-pin", 16)
                                    <input class="input" id="homeCity" placeholder="@T("Start typing…")" type="text" name="homeCity" value="@Model.HomeCity" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="city-suggestions" />
                                </div>
                                <ul class="ac-list" id="city-suggestions" role="listbox" hidden></ul>
                            </div>
                            <p class="hint">@T("Canadian cities only.")</p>
                        </div>

                        <div class="field">
                            <label class="label" for="preferredLanguage">@T("Preferred language")</label>
                            <div class="select-wrap control">
                                @Icon.Get("languages", 16)
                                <select class="select" id="preferredLanguage" name="preferredLanguage">
                                    @foreach (var (code, label) in languages)
                                    {
                                        if (code == preferred)
                                        {
                                            <option value="@code" selected>@label</option>
                                        }
                                        else
                                        {
                                            <option value="@code">@label</option>
                                        }
                                    }
                                </select>
                                @Icon.Get("chevron-down", 14)
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <div class="form-actions">
                <a class="btn btn-ghost" href="@Url.Action("Community", "Home")">@Icon.Get("arrow-left", 16) @T("Back")</a>
                <span class="grow"></span>
                <span class="aside">@Icon.Get("lock", 13) @T("Saved when you continue")</span>
                <button class="btn btn-primary" type="submit" data-busy>
                    <span>@T("Continue")</span>
                    @Icon.Get("arrow-right", 16, "i-nudge")
                </button>
            </div>
        </form>
    </div>
</div>
